# Application port
PORT=5000

# Globus app client used by hubmap-commons AuthHelper to introspect incoming tokens.
# Use a client ID that hubmap-commons has a groups file for (same pair as entity-api).
APP_CLIENT_ID=''
APP_CLIENT_SECRET=''

# Full base URLs (no trailing slash) of the APIs this deployment calls.
# One app.cfg per deployment (HuBMAP or SenNet), so URLs are written out in full.
ENTITY_BASE_URL='https://entity-api.dev.hubmapconsortium.org'
INGEST_BASE_URL='https://ingest-api.dev.hubmapconsortium.org'

# Optional extra headers sent on calls to entity-api and ingest-api.
# SenNet deployments only; omit this line for HuBMAP.
# EXTRA_API_HEADERS={'X-SenNet-Application': 'portal-ui'}